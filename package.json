{
  "name": "crypto-lab-tls-handshake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/phase-checks.ts all",
    "verify:keyschedule": "tsx scripts/phase-checks.ts keyschedule",
    "verify:auth": "tsx scripts/phase-checks.ts auth",
    "verify:record": "tsx scripts/phase-checks.ts record",
    "verify:handshake": "tsx scripts/phase-checks.ts handshake",
    "verify:resumption": "tsx scripts/phase-checks.ts resumption",
    "test:a11y": "playwright test",
    "test:mutations": "tsx scripts/mutations.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
